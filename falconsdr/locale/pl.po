# --- raw IQ recording (recording_panel/iq_recorder, technical/advanced) ---

msgid "Record raw IQ"
msgstr "Nagraj surowy sygnał IQ"

msgid "Advanced/technical: records the actual wideband complex samples this app demodulates from, in the SigMF format (readable by GNU Radio, Inspectrum, SDR++, ...) - independent of any specific channel or trigger. Saved to a 'raw_iq' subfolder, separate from the Playback library. Warning: uncompressed IQ is large - roughly sample_rate x 8 bytes/second (~19 MB/s at this app's default 2.4 MSPS capture bandwidth)."
msgstr "Zaawansowane/techniczne: nagrywa faktyczne szerokopasmowe próbki zespolone, z których program demoduluje sygnał, w formacie SigMF (odczytywalnym przez GNU Radio, Inspectrum, SDR++...) - niezależnie od konkretnego kanału czy triggera. Zapisywane w podfolderze 'raw_iq', osobno od biblioteki Odtwarzacza. Uwaga: nieskompresowany IQ zajmuje dużo miejsca - w przybliżeniu sample_rate x 8 bajtów/sekundę (~19 MB/s przy domyślnym paśmie przechwytywania 2,4 MSPS tego programu)."

msgid "■ Stop recording IQ"
msgstr "■ Zatrzymaj nagrywanie IQ"

msgid "Recording raw IQ..."
msgstr "Nagrywanie surowego IQ..."


