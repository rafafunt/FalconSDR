[Unit]
Description=FalconSDR receiver (web UI on port 8765)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Not root: the dongle only needs the plugdev group (60-rtl-sdr.rules).
User=falconsdr
SupplementaryGroups=plugdev
# Allow AcquisitionThread / ScannerEngine to use SCHED_FIFO (priority 10) without root.
LimitRTPRIO=20
AmbientCapabilities=CAP_SYS_NICE
WorkingDirectory=/opt/falconsdr
ExecStart=/opt/falconsdr/.venv/bin/python /opt/falconsdr/main.py --server --start
# SIGTERM closes every open recording cleanly (sdr-mode switches stop this unit).
TimeoutStopSec=15
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
